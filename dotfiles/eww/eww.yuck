(deflisten time :initial "--:--:--" "./modules/time")
(defwidget w_time [full]
   (box :class "container time"
      {full ? "${time.full}" : "${time.partial}"}
   )
)

(deflisten workspaces :initial '{ "lol": ""}' "modules/workspaces")
(defwidget w_workspaces [monitor]
   (box :class "workspaces container"
      (for wsp in {workspaces[monitor].tags}
         (box :class "${wsp.class}"
            (button :class "tag_button"
                    :onclick "mmsg -s -t ${wsp.name}"
               "${wsp.name}"
            )
         )
      )
   )
)

; bluetooth
; wifi
; volume
; battery

(defwidget w_primary [monitor]
   (box :class "main"
      (box :halign "start"
         (w_workspaces :monitor "${monitor}")
      )
      (box :halign "center"
         (w_time :full true)
      )
      (box :halign "end"
      )
   )
)
(defwidget w_secondary [monitor]
   (box :class "main"
      (box :halign "start"
         (w_workspaces :monitor "${monitor}")
      )
      (box :halign "center"
      )
      (box :halign "end"
         (w_time :full false)
      )
   )
)

(defwindow DP-1
   :monitor "DP-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_primary :monitor "DP-1")
)
(defwindow eDP-1
   :monitor "eDP-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_primary :monitor "eDP-1")
)
(defwindow HDMI-A-1
   :monitor "HDMI-A-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_secondary :monitor "HDMI-A-1")
)
