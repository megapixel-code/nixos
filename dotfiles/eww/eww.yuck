(deflisten time :initial '{"full": "--:--:--", "partial": "--:--:--"}' "make out/time; out/time")
(defwidget w_time [full]
   (box :class "time container"
      {full ? "${time.full}" : "${time.partial}"}))


(deflisten workspaces "make out/workspaces; out/workspaces")
(defwidget w_workspaces [monitor]
   (box :class "workspaces container"
      (for wsp in {workspaces[monitor].tags}
         (box :class "${wsp.class}"
            (button :class "tag_button"
                    :active true
                    :onclick "mmsg -s -t ${wsp.name}"
               "${wsp.name}")))))


(deflisten keymode "mmsg watch keymode")
(defwidget w_keymode []
   (box :class {keymode["keymode"]=="resize" ? "keymode container" : "empty"}
      {keymode["keymode"]=="resize" ? "R" : ""}))


(deflisten network "make out/network; out/network")
(defwidget w_network []
   (box :class "network container"
      "${network}"))


(deflisten volume "make out/volume; out/volume")
(defwidget w_volume []
   (eventbox :timeout "50ms"
             :onscroll "$NIXOS_CONFIG_DIR/dotfiles/scripts/volume {}"
             :onrightclick "$NIXOS_CONFIG_DIR/dotfiles/scripts/volume mute"
      (box :class "volume container"
       "${volume}")))


(deflisten battery "make out/battery; out/battery")
(defwidget w_battery []
   (box :class {battery != "" ? "battery container" : "empty"}
      "${battery}"))

; TODO: library file
; TODO:
; bluetooth
; notifications

(defwidget w_primary [monitor]
   (box :class "main"
      (box :space-evenly false :halign "start"
         (w_workspaces :monitor "${monitor}")
         (w_keymode))
      (box :space-evenly false :halign "center"
         (w_time :full true))
      (box :space-evenly false :halign "end"
         (w_network)
         (w_volume)
         (w_battery))))

(defwidget w_secondary [monitor]
   (box :class "main"
      (box :space-evenly false :halign "start"
         (w_workspaces :monitor "${monitor}")
         (w_keymode))
      (box :space-evenly false :halign "center")
      (box :space-evenly false :halign "end"
         (w_time :full false))))


(defwindow DP-1
   :monitor "DP-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_primary :monitor "DP-1"))

(defwindow eDP-1
   :monitor "eDP-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_primary :monitor "eDP-1"))

(defwindow HDMI-A-1
   :monitor "HDMI-A-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (w_secondary :monitor "HDMI-A-1"))
