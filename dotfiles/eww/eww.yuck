(defpoll time
   :interval "1s"
   :initial "--:--:--"
   `date "+%d %B %Y | %H:%M:%S"`
)

(defwidget w_time []
   (box :class "container time"
      "${time}"
   )
)

(deflisten workspaces :initial '{ "lol": ""}' "modules/workspaces")

(defwidget w_workspaces [monitor]
   (box :class "workspaces container"
      (for wsp in {workspaces[monitor].tags}
         (box :class "${wsp.class}"
            (button :class "tag_button"
                    :onclick "mmsg -s -t ${wsp.name}"
               "${wsp.name}"
            )
         )
      )
   )
)

(defwindow primary_monitor
   :monitor "DP-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (box :class "main"
      (box :halign "start"
         (w_workspaces :monitor "DP-1")
      )
      (box :halign "center"
         (w_time)
      )
      (box :halign "end"
      )
   )
)

(defwindow secondary_monitor
   :monitor "HDMI-A-1"
   :geometry (geometry :x "0px"
                       :y "0px"
                       :width "100%"
                       :height "30px"
                       :anchor "bottom center")
   :exclusive true
   :stacking "fg"
   :namespace "bar"

   (box :class "main"
      (box :halign "start"
         (w_workspaces :monitor "HDMI-A-1")
      )
      (box :halign "center"
      )
      (box :halign "end"
         (w_time)
      )
   )
)
