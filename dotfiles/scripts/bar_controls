status_file="$XDG_CACHE_HOME/toggle.eww"

open() {
	eww daemon
	eww open DP-1
	eww open eDP-1
	eww open HDMI-A-1
	mkdir -p "$(dirname "$status_file")"
	touch "$status_file"
}

close() {
	eww kill
	rm -f "$status_file"
}

reload() {
	eww reload
}

toggle() {
	if [[ -e $status_file ]]; then
		close
	else
		open
	fi
}

if [[ $1 == "open" ]]; then
	open
elif [[ $1 == "close" ]]; then
	close
elif [[ $1 == "reload" ]]; then
	reload
elif [[ $1 == "toggle" ]]; then
	toggle
fi
